+class _SpyRng:
+    """Counts standard_normal draws; returns a deterministic stream."""
+
+    def __init__(self) -> None:
+        self.calls = 0
+        self._inner = np.random.default_rng(0)
+
+    def standard_normal(self):
+        self.calls += 1
+        return self._inner.standard_normal()
