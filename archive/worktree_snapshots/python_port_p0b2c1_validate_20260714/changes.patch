+            states,
+            phi_history,
+            np.zeros(3),
+            np.eye(6),
+        )
+        self.assertLess(solution.transmit_time_s, t_grid[0])  # event unclipped
+        np.testing.assert_array_equal(initial.phi_r_tx, phi_start[:3, :])
+        np.testing.assert_array_equal(
