+    def sizeHint(self):
+        page = self.currentWidget()
+        return page.sizeHint() if page else QSize(960, 720)
+
+    def minimumSizeHint(self):
+        page = self.currentWidget()
+        return page.minimumSizeHint() if page else QSize(960, 720)
